PAYMENT_GATEWAY=fake
MESSAGING_PROVIDER=fake
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
NETWORK_DRIVER=fake
NETWORK_MUTATIONS_ENABLED=false
# Roles allowed to dispatch RouterOS/PPPoE device operations. Tenancy is still
# required; any role not listed here (including empty) fails closed.
NETWORK_OPERATOR_ROLES=owner,admin
NETWORK_DISCOVERY_PROVIDER=fake
NETWORK_DISCOVERY_FRESHNESS_SECONDS=86400
ROUTEROS_DISCOVERY_TRANSPORT=api_ssl
ROUTEROS_DISCOVERY_CONNECT_TIMEOUT_SECONDS=3
ROUTEROS_DISCOVERY_READ_TIMEOUT_SECONDS=5
ROUTEROS_DISCOVERY_INSECURE_TLS=false
GO_NETWORK_ENGINE_ALLOW_INSECURE_ROUTEROS_TLS=false
GO_NETWORK_ENGINE_URL=http://127.0.0.1:8787
GO_NETWORK_ENGINE_TOKEN=
GO_NETWORK_ENGINE_ADDRESS=127.0.0.1:8787
GO_NETWORK_ENGINE_CONNECT_TIMEOUT_SECONDS=2
GO_NETWORK_ENGINE_TIMEOUT_SECONDS=10
# Phase 6I mutation provider selection, consumed by the Go network engine.
# Safe default is "fake": every write stays in the in-memory simulation.
# "routeros" is refused at startup until an allowlisted real write provider is
# registered, and an unknown, empty, or oddly spaced value fails closed too.
# The engine never silently substitutes the simulation for a real router, and
# this selection is independent of the discovery and monitoring providers above.
NETWORK_MUTATION_PROVIDER=fake
MONITORING_DRIVER=fake
MONITORING_INTERVAL=60
MONITORING_FRESHNESS_SECONDS=180
MONITORING_RETENTION_DAYS=14
MONITORING_CHECKPOINT_SECONDS=120
MONITORING_LIVE_FRESHNESS_SECONDS=30
MONITORING_LIVE_OFFLINE_FAILURE_THRESHOLD=3
MONITORING_LIVE_CACHE_TTL_SECONDS=90
MONITORING_CAPABILITY_CHECKPOINT_SECONDS=86400
MONITORING_CAPABILITY_RETENTION_DAYS=90
OUTAGE_MINIMUM_CONNECTIONS=3
OUTAGE_WINDOW_MINUTES=10

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cosmiclink
DB_USERNAME=cosmiclink_app
DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=cosmiclink_
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=default
CACHE_PREFIX=cosmiclink_cache_

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
